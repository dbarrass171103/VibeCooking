@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService
@inject IDialogService DialogService

<MudThemeProvider Theme="@ThemeService.CurrentTheme.MudTheme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5">Vibe Cooking</MudText>
        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       aria-label="Settings"
                       OnClick="OpenSettingsAsync" />

    </MudAppBar>

    <MudMainContent Style="padding-bottom:80px;">
        @Body
    </MudMainContent>

    <NavMenu />
</MudLayout>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitAsync();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private async Task OpenSettingsAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        await DialogService.ShowAsync<SettingsDialog>("Settings", options);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;
}
