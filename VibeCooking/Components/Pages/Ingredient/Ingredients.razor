@* Page that lets the user build their ingredient list.
   Binary ingredients (Seasonings/Oils) are toggled on/off.
   Non-binary ingredients open a quantity dialog on tap.
   Custom ingredients are added via a dialog and put into their chosen category. *@

@page "/ingredients"
@page "/"

@using VibeCooking.Models
@using VibeCooking.ViewModels

@inject IngredientsViewModel ViewModel
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">

    <MudText Typo="Typo.h4" GutterBottom="false">My Ingredients</MudText>

    <MudText Class="mt-1 mb-6" Typo="Typo.body1" Color="Color.Secondary">
        Select what you have available and we'll generate recipes around them.
    </MudText>

    @foreach (var kvp in ViewModel.IngredientsByCategory)
    {
        @* Skip empty sections — avoids rendering a header with no ingredients *@
        @if (kvp.Value.Count == 0) continue;

        @RenderSection(GetCategoryLabel(kvp.Key), kvp.Value, kvp.Key)
    }

    @* Custom ingredient entry *@
    <MudText Typo="Typo.h6" Class="mb-2">Something else?</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCustomIngredientDialog">
            Add Custom Ingredient
        </MudButton>
    </MudPaper>

</MudContainer>

@code {

    // Initialises the ViewModel
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ViewModel.InitAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initialise: {ex.Message}", Severity.Error);
        }
    }

    // Opens the quantity dialog for a non-binary catalog ingredient.
    private async Task OpenQuantityDialog(UserIngredient ingredient)
    {
        // If already selected, tapping again deselects immediately without reopening the dialog.
        if (ingredient.IsSelected)
        {
            ViewModel.DeselectIngredient(ingredient);
            StateHasChanged();
            return;
        }

        var dialog = await DialogService.ShowAsync<QuantityDialog>(
            "Enter Quantity",
            new DialogParameters<QuantityDialog>
            {
                { x => x.IngredientName, ingredient.Name },
                { x => x.Quantity, ingredient.Quantity }
            },
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            });

        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string quantity)
            ViewModel.SelectIngredient(ingredient, quantity);
        else
            ViewModel.DeselectIngredient(ingredient);

        StateHasChanged();
    }

    // Opens the custom ingredient dialog.
    private async Task OpenCustomIngredientDialog()
    {
        var dialog = await DialogService.ShowAsync<CustomIngredientDialog>(
            "Add Ingredient",
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            });

        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UserIngredient ingredient)
        {
            ViewModel.AddCustomIngredient(ingredient.Name, ingredient.Category);
            StateHasChanged();
        }
    }

    // Renders a labeled ingredient section as a row of toggle buttons.
    private RenderFragment RenderSection(string title, List<UserIngredient> ingredients, IngredientCategory category) => __builder =>
    {
        bool isBinary = category is IngredientCategory.Seasonings or IngredientCategory.OilsAndCondiments;

        <MudText Typo="Typo.h6" Class="mb-2">@title</MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @(isBinary ? "Tap to mark as available" : "Tap to add — tap again to remove")
        </MudText>

        <MudPaper Class="pa-4 mb-6" Elevation="1">
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var ingredient in ingredients)
                {
                    @if (isBinary)
                    {
                        <MudButton Variant="@(ingredient.IsSelected ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="@(() => ViewModel.ToggleBinary(ingredient))">
                            @ingredient.Name
                            @if (ingredient.IsCustom)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="@(() => { ViewModel.RemoveCustomIngredient(ingredient); StateHasChanged(); })" />
                            }
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="@(ingredient.IsSelected ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenQuantityDialog(ingredient))">
                            @ingredient.Name
                            @if (ingredient.IsSelected && !string.IsNullOrWhiteSpace(ingredient.Quantity))
                            {
                                <span style="margin-left:4px; opacity:0.8;">— @ingredient.Quantity</span>
                            }
                            @if (ingredient.IsCustom)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="@(() => { ViewModel.RemoveCustomIngredient(ingredient); StateHasChanged(); })" />
                            }
                        </MudButton>
                    }
                }
            </div>
        </MudPaper>;
    };

    //Converts category enum values to human-readable section headings
    private static string GetCategoryLabel(IngredientCategory category) => category switch
    {
        IngredientCategory.OilsAndCondiments => "Oils & Condiments",
        _ => System.Text.RegularExpressions.Regex.Replace(category.ToString(), "(\\B[A-Z])", " $1")
    };
}