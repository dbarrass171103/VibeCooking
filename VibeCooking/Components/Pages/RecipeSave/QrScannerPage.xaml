<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="VibeCooking.Components.Pages.RecipeSave.QrScannerPage">

    <Grid>
        <scanner:CameraView x:Name="cameraView"
                            OnDetectionFinished="CameraView_OnDetectionFinished"
                            IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}" />

        <!-- Overlay the camera view UI -->
        <Button Text="Close"
                WidthRequest="100"
                HeightRequest="44"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="Black"
                TextColor="White"
                Opacity="0.8"
                Clicked="OnCloseClicked"/>
    </Grid>

</ContentPage>